          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "uz_org_forms"
          ]
        },
        "uz_merchant_prefix": {
          "type": "custom",
          "char_filter": [
            "uz_cyrillic_to_latin"
          ],
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "uz_org_forms",
            "edge_prefix"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "grLegalEntityId": {
        "type": "keyword"
      },
      "fullName": {
        "type": "text",
        "analyzer": "uz_merchant",
        "fields": {
          "prefix": {
            "type": "text",
            "analyzer": "uz_merchant_prefix",
            "search_analyzer": "uz_merchant"
          }
        }
      },
      "updatedAt": {
        "type": "date"
      },
      "shortName": {
        "type": "text",
        "analyzer": "uz_merchant",
        "fields": {
          "prefix": {
            "type": "text",
