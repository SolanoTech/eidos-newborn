# Скопируйте в .env и задайте собственные значения.
# Файл .env в репозиторий не попадает. Переменные без значения обязательны:
# docker compose не запустится, пока они не заданы. Случайное значение даёт
# команда `openssl rand -hex 24`.

# Внутренний административный API (заголовок X-Admin-Token).
ADMIN_TOKEN=

# PostgreSQL: пароль пользователя postgres. Действует только при первой
# инициализации тома — для существующего тома укажите прежний пароль.
POSTGRES_PASSWORD=

# Keycloak: пароль первоначального администратора (логин admin). Действует
# только при первом запуске на пустой базе keycloak.
KEYCLOAK_ADMIN_PASSWORD=

# Адрес Keycloak, по которому его открывает браузер пользователя консолей.
# Вшивается в образы консолей при сборке: после смены пересоберите
# eidos-cdi-ui и eidos-cdp-ui.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Хранилище ключей OpenBao: токен доступа и имя ключа шифрования ключей.
OPENBAO_TOKEN=
OPENBAO_KEK_NAME=eidos-pd-kek

# Политика перезапуска контейнеров: unless-stopped, always, on-failure или no.
RESTART_POLICY=unless-stopped

# События о согласиях.
CONSENT_EVENTS_TOPIC=consent-events
# Проход по истёкшим согласиям: ежедневно в 00:05.
CONSENT_EXPIRY_CRON=0 5 0 * * *
