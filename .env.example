# Скопируйте в .env и задайте собственные значения.
# Файл .env в репозиторий не попадает.

# Внутренний административный API (заголовок X-Admin-Token).
ADMIN_TOKEN=

# PostgreSQL.
POSTGRES_PASSWORD=

# Хранилище ключей OpenBao: токен доступа и имя ключа шифрования ключей.
OPENBAO_TOKEN=
OPENBAO_KEK_NAME=eidos-pd-kek

# События о согласиях.
CONSENT_EVENTS_TOPIC=consent-events
# Проход по истёкшим согласиям: ежедневно в 00:05.
CONSENT_EXPIRY_CRON=0 5 0 * * *
