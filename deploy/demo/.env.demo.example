# Скопируйте в .env рядом с docker-compose.demo.yml и задайте значения.
# Значений по умолчанию у демо-стенда нет: он публичный, и пустой секрет
# должен ломать запуск, а не проходить незамеченным.

# ---------- Имена ----------
# Три имени на один IP: две консоли и Keycloak. На бесплатном DuckDNS это три
# записи из пяти доступных.
DEMO_ADMIN_HOST=eidos-admin.example.org
DEMO_CDP_HOST=eidos-cdp.example.org
DEMO_AUTH_HOST=eidos-auth.example.org

# Адрес для Let's Encrypt: уведомления об истечении сертификатов.
DEMO_ACME_EMAIL=

# ---------- Доступ ----------
# Своего барьера у стенда нет: административные пути консолей проверяет
# Gravitee по JWT Keycloak, остальное API закрывает eidos-cdi-ui-backend.
# Кому показываете стенд — тому и заводите пользователя в Keycloak.

# ---------- Секреты платформы ----------
POSTGRES_PASSWORD=
ADMIN_TOKEN=
OPENBAO_TOKEN=
OPENBAO_KEK_NAME=eidos-pd-kek

# OpenSearch: не короче 8 символов, заглавная, строчная, цифра, спецсимвол.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# ---------- Keycloak ----------
# Учётная запись администратора самого Keycloak. Его консоль наружу не
# публикуется (Caddy отдаёт 404 на /admin), доступ — только из внутренней сети.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Пароль пользователя, под которым показывают консоли. В realm-eidos.json
# лежит пароль для локального стенда — на публичном стенде его обязательно
# заменить: файл находится в открытом репозитории.
DEMO_CONSOLE_USER=admin
DEMO_CONSOLE_PASSWORD=

# ---------- Прочее ----------
CONSENT_EVENTS_TOPIC=consent-events
CONSENT_EXPIRY_CRON=0 5 0 * * *
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_RATE_LIMIT_FUZZY_SEARCH_PER_MINUTE=20
EIDOS_SEARCH_REINDEX_ON_STARTUP=false

# Токен источника, под которым засев кладёт демонстрационные карточки.
DEMO_SOURCE_TOKEN=

# ---------- Gravitee ----------
# Management API публикуется только на 127.0.0.1; setup_gravitee.py ходит в
# него под учётной записью администратора Gravitee. По умолчанию admin/admin —
# менять через его собственный API, наружу он не смотрит.
MGMT_URL=http://localhost:8083
MGMT_USER=admin
MGMT_PASS=admin
