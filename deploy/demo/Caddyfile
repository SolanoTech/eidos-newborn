# Край демонстрационного стенда: TLS от Let's Encrypt и маршрутизация по именам.
#
# Три имени на один IP — так консоли и Keycloak живут каждый на своём хосте и
# SPA не надо пересобирать под базовый путь.
#
# Своей аутентификации здесь нет, и она не нужна: административные пути
# консолей проверяет Gravitee по JWT Keycloak, остальное API закрывает
# eidos-cdi-ui-backend. Basic-аутентификация тут стояла, пока Gravitee не было,
# и оказалась несовместима с приложением: консоль сама ставит заголовок
# Authorization: Bearer, браузер перестаёт подставлять Basic, и запрос к API
# бесконечно получает 401.

{
	email {$DEMO_ACME_EMAIL}
}

# Административная консоль
https://{$DEMO_ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy eidos-cdi-ui:80
}

# Консоль фронт-офиса (Customer 360)
https://{$DEMO_CDP_HOST} {
	encode zstd gzip
	reverse_proxy eidos-cdp-ui:80
}

# Keycloak. Консоль администратора наружу не отдаём — она доступна только из
# внутренней сети машины.
https://{$DEMO_AUTH_HOST} {
	encode zstd gzip

	@admin path /admin* /metrics* /health*
	respond @admin 404

	reverse_proxy keycloak:8180 {
		header_up X-Forwarded-Proto https
	}
}
